# Example server .env (copy to server/.env and fill values)

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_db

# JWT secret used to sign tokens
JWT_SECRET=your_jwt_secret_here

# Frontend origin(s) used for CORS
# You can provide a single origin, or a comma-separated list of origins (useful for allowing both deployed frontend and localhost during development).
# Example (allow two deployed domains + local dev):
# FRONTEND_URL=https://ai-resume-evaluator-and-job-matcher-1.onrender.com,https://ai-resume-evaluator-and-job-matcher.onrender.com,http://localhost:5173
# For local-only development use:
FRONTEND_URL=http://localhost:5173

# Port
PORT=5000

# Gemini / LLM API key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (optional)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email credentials for sending password reset emails
# EMAIL_USER=youremail@example.com
# EMAIL_PASS=your_email_password_or_app_password
